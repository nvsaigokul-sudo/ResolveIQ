{
  "index_patterns": ["resolveiq-traces-*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 2,
        "number_of_replicas": 1,
        "refresh_interval": "1s",
        "mapping": {
          "total_fields": {
            "limit": 2000
          }
        }
      }
    },
    "mappings": {
      "_routing": {
        "required": true
      },
      "properties": {
        "event_id": {
          "type": "keyword"
        },
        "tenant_id": {
          "type": "keyword"
        },
        "project_id": {
          "type": "keyword"
        },
        "service_id": {
          "type": "keyword"
        },
        "environment": {
          "type": "keyword"
        },
        "trace_id": {
          "type": "keyword"
        },
        "span_id": {
          "type": "keyword"
        },
        "parent_span_id": {
          "type": "keyword"
        },
        "operation_name": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "start_time": {
          "type": "date"
        },
        "duration_ms": {
          "type": "long"
        },
        "status_code": {
          "type": "keyword"
        },
        "attributes": {
          "type": "object",
          "dynamic": true
        },
        "resource_attributes": {
          "type": "object",
          "dynamic": true
        }
      }
    }
  },
  "priority": 100,
  "_meta": {
    "description": "ResolveIQ canonical trace spans index template with tenant routing and 7-day retention (PRD §10.4, §13.3, §37)"
  }
}
